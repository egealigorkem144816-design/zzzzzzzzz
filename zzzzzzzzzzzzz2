seninle paylaşacağım kod birazdan betimleyeceğim bir oyun için yazılan bir python kodu ama çok fazla hata var. Bu oyunu optimal bir duruma getirip bahsedilen betimlemeye uygun bir oyun oluşturmanı istiyorum.

Oyunun betimlemesi
Şimdi senden bir oyun tasarlamanı isteyeceğim, pythondan bu oyunu oluşturabilirsin. Bu oyun işaret dili öğrenen kişiler için tasarlanacak. Oyun bir yemek yapma oyunu, basit ve eğitici. Oyunun ilk penceresinde oyna butonu var buna tıklayarak oyuna başlıyorsun. Oyun başladıktan sonra  karşına boş bir tabak geliyor. Sağ üst köşede küçük bir görsel olarak yemeğin cartoon stilinde çizilmiş bir fotoğrafı var. Diyelim ki bu yemek hamburger olsun, hamburgerin oyun sonunda nasıl görüneceği sağ üstte gözüküyor. Orta üst kısımda da metin taşmıyacak şekilde hamburgerin içerisinde olması gereken malzemeler yazıyor. Maksimum 3 malzeme olabilir her bir yemek için. Bu 3 malzemenin işaret diliyle işaretleri animasyonlarla gösterilir, oyun içerisinde eğer üzerine tıklanırsa animasyon oynamaya başlar ve örneğin "marul" sözcüğünün işareti oluşur. Fakat oyuncu marul sözcüğünün sadece nasıl türk işaret dilinde işaretlendiğini görür altında marul yazmaz. Ancak tabağa sürüklendiği ve bırakıldığı zaman altında marul yazar aynı zamanda sürüklenen işaret tabağa gelince eğer üstte yazan malzemeyle aynı şeyse işaret bir anda malzemenin kendisine dönüşür. Bu sayede öğrenciler işaretleri öğrenmiş olacaklar. Eğer istenilen malzemelerin içerisinde marul varsa yeşil tik çıkarken eğer yanlış malzeme çıkarsa kırmızı çarpı işaretiyle beraber işaretin asıl anlamı az önce marul örneğinde bahsettiğim gibi yazı olarak karşımıza çıkar. Oyun orta üstteki malzemeleri yerleştirdiğimizde sonlanır ve küçük fotoğraftaki bitmiş yemekle tabaktaki yemek aynı olunca da ekranda büyük bir yeşil tik ortaya çıkar. Bu şekilde yaklaşık 20 tane yemek ve aynı formülde işlenen leveller olacak. Oyunun genel sanat tarzı cartoony bir şekilde olacak ve o şekilde görseller oluşturulacak.

Kod 

import os, sys, json, pygame, textwrap
from pygame import Rect

BASE = os.path.dirname(__file__)
ASSETS = os.path.join(BASE, "assets")

def load_image(name):
    return pygame.image.load(os.path.join(ASSETS, name)).convert_alpha()

def wrap_text(surface, text, font, color, rect, line_height=4):
    words = text.split()
    lines, line = [], ""
    for w in words:
        test = (line + " " + w).strip()
        if font.size(test)[0] <= rect.width:
            line = test
        else:
            lines.append(line)
            line = w
    if line:
        lines.append(line)
    y = rect.y
    for ln in lines:
        img = font.render(ln, True, color)
        surface.blit(img, (rect.x, y))
        y += img.get_height() + line_height

class SignSprite:
    def __init__(self, name, sheet, pos, frame_w=96, frame_h=96, fps=6):
        self.name = name
        self.sheet = sheet
        self.frame_w = frame_w
        self.frame_h = frame_h
        self.frames = sheet.get_width() // frame_w
        self.rect = pygame.Rect(pos[0], pos[1], frame_w, frame_h)
        self.anim = False
        self.fps = fps
        self.time = 0.0
        self.frame = 0
        self.dragging = False
        self.offset = (0,0)

    def start(self):
        self.anim = True

    def stop(self):
        self.anim = False
        self.frame = 0

    def update(self, dt):
        if self.anim:
            self.time += dt
            if self.time >= 1.0/self.fps:
                self.time = 0.0
                self.frame = (self.frame + 1) % self.frames

    def draw(self, surf):
        x = self.frame * self.frame_w
        frame = self.sheet.subsurface(pygame.Rect(x, 0, self.frame_w, self.frame_h))
        surf.blit(frame, self.rect.topleft)
        shadow = pygame.Surface((self.rect.width, 8), pygame.SRCALPHA)
        shadow.fill((0,0,0,50))
        surf.blit(shadow, (self.rect.x, self.rect.bottom-4))

class IngredientPlaced:
    def __init__(self, name, icon, pos):
        self.name = name
        self.icon = icon
        self.rect = icon.get_rect(topleft=pos)

    def draw(self, surf, font):
        surf.blit(self.icon, self.rect.topleft)
        label = font.render(self.name, True, (30,30,30))
        r = label.get_rect(midtop=(self.rect.centerx, self.rect.bottom+2))
        surf.blit(label, r)

class Game:
    def __init__(self):
        pygame.init()
        pygame.display.set_caption("İşaretli Aşçı")
        self.W, self.H = 1024, 640
        self.screen = pygame.display.set_mode((self.W, self.H))
        self.clock = pygame.time.Clock()

        self.bg    = load_image("background.png")
        self.plate = load_image("plate.png")
        self.tick  = load_image("tick.png")
        self.cross = load_image("cross.png")

        self.font  = pygame.font.SysFont("DejaVuSans", 22, bold=True)
        self.font_big = pygame.font.SysFont("DejaVuSans", 44, bold=True)

        self.state = "menu"
        self.level_index = 0
        with open(os.path.join(BASE, "levels.json"), "r", encoding="utf-8") as f:
            self.levels = json.load(f)

        self.button_rect = Rect(self.W//2-100, self.H//2-30, 200, 60)

        self.required = []
        self.palette  = []
        self.sign_sprites = []
        self.ingredient_icons = {}
        self.placed = []
        self.plate_rect = Rect(80, 360, self.plate.get_width(), self.plate.get_height())
        self.feedback_timer = 0.0
        self.feedback_kind = None
        self.feedback_text = ""
        self.dish_preview = None

    def load_level(self, idx):
        L = self.levels[idx]
        self.required = list(L["required"])
        self.palette  = list(L["palette"])
        self.placed.clear()
        self.sign_sprites = []
        x, y = 60, 480
        gap = 110
        for nm in self.palette:
            sheet = load_image(f"sign_{nm}.png")
            sp = SignSprite(nm, sheet, (x,y))
            self.sign_sprites.append(sp)
            x += gap
            if x > self.W-100:
                x = 60
                y += gap

        self.ingredient_icons = {nm: load_image(f"ingredient_{nm}.png") for nm in set(self.palette)}
        self.dish_preview = load_image(f"dish_{idx:02d}.png")

    def rect_hover(self, r):
        mx, my = pygame.mouse.get_pos()
        return r.collidepoint(mx, my)

    def handle_menu(self, dt):
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit(); sys.exit(0)
            elif e.type == pygame.MOUSEBUTTONDOWN and e.button == 1:
                if self.rect_hover(self.button_rect):
                    self.state = "play"
                    self.level_index = 0
                    self.load_level(self.level_index)

        self.screen.blit(self.bg, (0,0))
        title = self.font_big.render("İşaretli Aşçı", True, (50,50,80))
        self.screen.blit(title, title.get_rect(center=(self.W//2, self.H//2-120)))

        pygame.draw.rect(self.screen, (255,255,255), self.button_rect, border_radius=18)
        pygame.draw.rect(self.screen, (60,60,80), self.button_rect, 3, border_radius=18)
        label = self.font.render("OYNA", True, (60,60,80))
        self.screen.blit(label, label.get_rect(center=self.button_rect.center))

    def handle_play(self, dt):
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit(); sys.exit(0)
            elif e.type == pygame.MOUSEBUTTONDOWN and e.button == 1:
                for sp in reversed(self.sign_sprites):
                    if sp.rect.collidepoint(e.pos):
                        sp.dragging = True
                        mx, my = e.pos
                        sp.offset = (sp.rect.x - mx, sp.rect.y - my)
                        sp.start()
                        break
            elif e.type == pygame.MOUSEBUTTONUP and e.button == 1:
                for sp in self.sign_sprites:
                    if sp.dragging:
                        sp.dragging = False
                        if self.plate_rect.colliderect(sp.rect):
                            self.on_drop(sp)
                        sp.stop()

        for sp in self.sign_sprites:
            sp.update(dt)
            if sp.dragging:
                mx, my = pygame.mouse.get_pos()
                sp.rect.topleft = (mx + sp.offset[0], my + sp.offset[1])

        self.screen.blit(self.bg, (0,0))
        self.screen.blit(self.plate, self.plate_rect.topleft)

        x0, y0 = self.plate_rect.x+40, self.plate_rect.y+50
        for i, pl in enumerate(self.placed):
            pl.rect.topleft = (x0 + i*110, y0)
            pl.draw(self.screen, self.font)

        req_text = "Gerekenler: " + ", ".join(self.required)
        wrap_rect = Rect(240, 12, 520, 60)
        pygame.draw.rect(self.screen, (255,255,255), wrap_rect, border_radius=12)
        pygame.draw.rect(self.screen, (200,200,220), wrap_rect, 2, border_radius=12)
        wrap_text(self.screen, req_text, self.font, (40,40,60), wrap_rect)

        self.screen.blit(self.dish_preview, (self.W-200, 12))

        for sp in self.sign_sprites:
            sp.draw(self.screen)

        if self.feedback_timer > 0.0:
            self.feedback_timer -= dt
            icon = self.tick if self.feedback_kind == "ok" else self.cross
            self.screen.blit(icon, (self.plate_rect.centerx-32, self.plate_rect.y-72))
            if self.feedback_text:
                lbl = self.font.render(self.feedback_text, True, (0,0,0))
                self.screen.blit(lbl, lbl.get_rect(midtop=(self.plate_rect.centerx, self.plate_rect.y-72+68)))

        req_set = set(self.required)
        placed_set = set([p.name for p in self.placed])
        if req_set == placed_set and len(self.placed) == len(self.required):
            center = (self.W//2, self.H//2)
            big = pygame.transform.smoothscale(self.tick, (220,220))
            self.screen.blit(big, big.get_rect(center=center))
            txt = self.font_big.render("TEBRİKLER!", True, (40,90,40))
            self.screen.blit(txt, txt.get_rect(center=(center[0], center[1]+150)))
            pygame.display.flip()
            pygame.time.delay(900)
            self.level_index += 1
            if self.level_index >= len(self.levels):
                self.state = "end"
            else:
                self.load_level(self.level_index)

    def on_drop(self, sp):
        if sp.name in self.required and sp.name not in [p.name for p in self.placed]:
            icon = self.ingredient_icons[sp.name]
            self.placed.append(IngredientPlaced(sp.name, icon, sp.rect.topleft))
            self.feedback_kind = "ok"
            self.feedback_text = ""
        else:
            self.feedback_kind = "no"
            self.feedback_text = sp.name
        self.feedback_timer = 1.0

        gx = max(60, min(sp.rect.x, 900))
        gy = 480 if sp.rect.y < 590 else 590
        sp.rect.topleft = (gx - (gx % 110), gy)

    def handle_end(self, dt):
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit(); sys.exit(0)
            elif e.type == pygame.MOUSEBUTTONDOWN and e.button == 1:
                self.state = "menu"

        self.screen.blit(self.bg, (0,0))
        msg = self.font_big.render("Tüm seviyeler tamamlandı!", True, (50,80,50))
        self.screen.blit(msg, msg.get_rect(center=(self.W//2, self.H//2-40)))
        sub = self.font.render("Devam etmek için tıklayın.", True, (60,60,80))
        self.screen.blit(sub, sub.get_rect(center=(self.W//2, self.H//2+20)))

    def run(self):
        while True:
            dt = self.clock.tick(60) / 1000.0
            if self.state == "menu":
                self.handle_menu(dt)
            elif self.state == "play":
                self.handle_play(dt)
            else:
                self.handle_end(dt)
            pygame.display.flip()

if __name__ == "__main__":
    Game().run()
